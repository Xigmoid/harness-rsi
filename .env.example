# Copy this file to `.env` and fill it in.  `.env` is gitignored; this
# template is what a researcher edits.
#
#   cp .env.example .env
#
# Every value here can also be given as a plain environment variable -- the
# scripts read the environment first and fall back to `.env`.

# --------------------------------------------------------------------------- #
# The model endpoint the agents talk to
# --------------------------------------------------------------------------- #
# Any OpenAI-compatible Chat Completions endpoint.  The pipeline was developed
# against a vLLM server that serves `glm5.3-flash` and needs no key, but
# nothing in the code depends on that particular server: the model id and the
# base URL are both parameters.
#
# The value has to be reachable **from inside the trial container**, so on
# macOS and Windows that means `host.docker.internal`, not `localhost`.
MODEL_BASE_URL=http://host.docker.internal:8000/v1

# The model id, as the endpoint knows it.
MODEL_NAME=glm5.3-flash

# The key.  Leave it EMPTY for an endpoint that does not check one (the vLLM
# server above does not).  A key that *is* needed must not be written into a
# job file: the recording proxy injects it on the way out instead, and the
# job file keeps the placeholder.
API_KEY=EMPTY
# The file the proxy reads the real key from, when there is one.
# API_KEY_FILE=MINIMAX_KEY.txt

# --------------------------------------------------------------------------- #
# Where the trials run
# --------------------------------------------------------------------------- #
# Harbor writes the trial directories here.  It has to be a real local path
# (not a network mount), and it needs a few GB.
#
# It also has to **survive a reboot**: macOS wipes /tmp on every boot, and a
# multi-day run does not survive losing its ledger.  The default is
# therefore under $HOME, not under /tmp.
RUN_ROOT=~/.rsi-harbor

# --------------------------------------------------------------------------- #
# The two Python interpreters
# --------------------------------------------------------------------------- #
# The drivers run under Python 3.12 (Harbor 0.24.0 needs it); the helper
# scripts run under the project venv, which has PyYAML and the HuggingFace
# hub client.
PY=.venv312/bin/python
PY3=.venv/bin/python

# --------------------------------------------------------------------------- #
# Concurrency
# --------------------------------------------------------------------------- #
# How many trials run at the same time, per harness.  The ceiling is memory:
# an opencode trial is ~500 MB and a mini trial ~100 MB, and the Docker VM
# usually has 10 GB.  24 mini + 10 opencode is ~7.5 GB.
MINI_CONCURRENCY=24
OPENCODE_CONCURRENCY=10

# --------------------------------------------------------------------------- #
# The MiniMax share (0 = every task is annotated by the model above)
# --------------------------------------------------------------------------- #
# The second provider is wired in but off by default.  Setting this above 0
# carves that share of each half out by the hash of the task name, and the
# main run skips exactly those tasks.
MINIMAX_SHARE=0.0
